# Secrets referenced by switchbot-remote.yaml.
# Copy to secrets.yaml (or add the entries to the secrets of your ESPHome
# Device Builder) and fill in your own values.

wifi_ssid: "..."
wifi_password: "..."

# OTA password of your choice
ota_password: "..."

# 32 random bytes, base64 encoded. Generate with:  openssl rand -base64 32
switchbot_remote_api_key: "..."
